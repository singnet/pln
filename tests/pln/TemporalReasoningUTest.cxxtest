#include <opencog/guile/SchemeEval.h>
#include <opencog/guile/SchemeSmob.h>
#include <opencog/atoms/base/Handle.h>
#include <opencog/atomspace/AtomSpace.h>
#include <opencog/ure/Rule.h>
#include <opencog/pln/types/atom_types.h>
#include <opencog/ure/backwardchainer/BackwardChainer.h>
#include <opencog/util/Logger.h>
#include <opencog/util/algorithm.h>
#include <cxxtest/TestSuite.h>
#include <string>
#include <vector>

using namespace opencog;
using namespace std;

class TemporalReasoningUTest: public CxxTest::TestSuite
{
private:
	AtomSpace as;
	SchemeEval eval;

public:
	TemporalReasoningUTest() : eval(&as)
	{
		logger().set_level(Logger::DEBUG);
		logger().set_timestamp_flag(false);
		logger().set_print_to_stdout_flag(true);

		string cur_ppp_dir = string(PROJECT_SOURCE_DIR),
			cur_dir = cur_ppp_dir + "/tests/pln",
			src_rule_dir = cur_ppp_dir + "/opencog/pln/rules/temporal";
		//vector<string> load_paths = {cur_ppp_dir, cur_dir, src_rule_dir};
		vector<string> load_paths = {cur_ppp_dir, cur_dir};
		for (string& p : load_paths)
		{
			string eval_str = string("(add-to-load-path \"") + p + string("\")");
			eval.eval(eval_str);
		}

		eval.eval("(use-modules (opencog))");
		eval.eval("(use-modules (opencog spacetime))");
		eval.eval("(use-modules (opencog exec))");
		eval.eval("(use-modules (opencog logger))");
		eval.eval("(use-modules (opencog ure))");
		eval.eval("(use-modules (opencog pln))");
		eval.eval("(use-modules (srfi srfi-1))");
	}

	~TemporalReasoningUTest()
	{
		// Erase the log file if no assertions failed.
		if (!CxxTest::TestTracker::tracker().suiteFailed())
			std::remove(logger().get_filename().c_str());
	}

	void setUp();
	void tearDown() {};
	void load_scm_files(std::vector<std::string>);

	void test_back_predictive_implication_scope_to_back_predictive_implication();
	void test_back_predictive_implication_to_implication();
	void test_lagged_introduction();
	void test_cogscm_temporal_deduction();
};

void TemporalReasoningUTest::setUp()
{
	as.clear();
}

void TemporalReasoningUTest::load_scm_files(std::vector<std::string> files)
{
	std::string hd("(load-from-path \"");
	std::string tl("\")");
	for (auto f: files) {
		string result = eval.eval(hd + f + tl);
		logger().debug() << "[TemporalReasoningUTest] Loaded \"" << f << "\":"
		                 << std::endl << result;
	}
}

static inline Handle bindlink(AtomSpace* as, const Handle& hlink)
{
   return HandleCast(hlink->execute(as));
}

/**
 * Test back-predictive-implication-scope-to-back-predictive-implication-rule defined in:
 * opencog/pln/rules/temporal/back-predictive-implication-scope-to-back-predictive-implication.scm
 */
void TemporalReasoningUTest::test_back_predictive_implication_scope_to_back_predictive_implication()
{
	logger().debug("BEGIN TEST: %s", __FUNCTION__);

	load_scm_files({"tests/pln/rules/back-predictive-implication-scope.scm",
	                "opencog/pln/rules/temporal/back-predictive-implication-scope-to-back-predictive-implication.scm"});

	// Apply the rule
	Handle rule = eval.eval_h("back-predictive-implication-scope-to-back-predictive-implication-rule");
	Handle results = bindlink(&as, rule);
	Handle expected = eval.eval_h
		("(SetLink"
		 "	(BackPredictiveImplicationLink (stv 0.345 0.091941)"
		 "		(SLink"
		 "			(ZLink))"
		 "		(LambdaLink"
		 "			(VariableList"
		 "				(VariableNode \"$X\")"
		 "				(VariableNode \"$T\"))"
		 "			(AtTimeLink"
		 "				(EvaluationLink"
		 "					(PredicateNode \"P\" (stv 1 1))"
		 "					(VariableNode \"$X\"))"
		 "				(VariableNode \"$T\")))"
		 "		(LambdaLink"
		 "			(VariableList"
		 "				(VariableNode \"$X\")"
		 "				(VariableNode \"$T\"))"
		 "			(AtTimeLink"
		 "				(EvaluationLink"
		 "					(PredicateNode \"Q\" (stv 1 1))"
		 "					(VariableNode \"$X\"))"
		 "				(VariableNode \"$T\")))))");

	std::cout << "results = " << results->to_string();
	std::cout << "expected = " << expected->to_string();

	TS_ASSERT_EQUALS(results, expected);
}

/**
 * Test back-predictive-implication-to-implication-rule defined in:
 * opencog/pln/rules/temporal/back-predictive-implication-to-implication.scm
 */
void TemporalReasoningUTest::test_back_predictive_implication_to_implication()
{
	logger().debug("BEGIN TEST: %s", __FUNCTION__);

	load_scm_files({"tests/pln/rules/back-predictive-implication-scope.scm",
					"opencog/pln/rules/temporal/back-predictive-implication-to-implication.scm",
	                "opencog/pln/rules/temporal/back-predictive-implication-scope-to-back-predictive-implication.scm"});

	// Apply the rules
	Handle rule1 = eval.eval_h("back-predictive-implication-scope-to-back-predictive-implication-rule");
	bindlink(&as, rule1);
	Handle rule = eval.eval_h("back-predictive-implication-to-implication-rule");
	Handle results = bindlink(&as, rule);
	Handle expected = eval.eval_h
		("(SetLink"
		 "(ImplicationLink (stv 0.345 0.091941)"
		 "		(LaggedLink"
		 "			(LambdaLink"
		 "				(VariableList"
		 "					(VariableNode \"$X\")"
		 "					(VariableNode \"$T\"))"
		 "				(AtTimeLink"
		 "					(EvaluationLink"
		 "						(PredicateNode \"P\" (stv 1 1))"
		 "						(VariableNode \"$X\"))"
		 "					(VariableNode \"$T\")))"
		 "			(SLink"
		 "				(ZLink)))"
		 "		(BackSequentialAndLink"
		 "			(SLink"
		 "				(ZLink))"
		 "			(LambdaLink"
		 "				(VariableList"
		 "					(VariableNode \"$X\")"
		 "					(VariableNode \"$T\"))"
		 "				(AtTimeLink"
		 "					(EvaluationLink"
		 "						(PredicateNode \"P\" (stv 1 1))"
		 "						(VariableNode \"$X\"))"
		 "					(VariableNode \"$T\")))"
		 "			(LambdaLink"
		 "				(VariableList"
		 "					(VariableNode \"$X\")"
		 "					(VariableNode \"$T\"))"
		 "				(AtTimeLink"
		 "					(EvaluationLink"
		 "						(PredicateNode \"Q\")"
		 "						(VariableNode \"$X\"))"
		 "					(VariableNode \"$T\"))))))");

	std::cout << "results = " << results->to_string();
	std::cout << "expected = " << expected->to_string();

	TS_ASSERT_EQUALS(results, expected);
}

/**
 * Test lagged-introduction-rule defined in:
 * opencog/pln/rules/temporal/lagged-introduction.scm
 */
void TemporalReasoningUTest::test_lagged_introduction()
{
	logger().debug("BEGIN TEST: %s", __FUNCTION__);

	load_scm_files({"tests/pln/rules/back-predictive-implication-scope.scm",
	                "opencog/pln/rules/temporal/lagged-introduction.scm"});

	// Apply the rules
	Handle rule = eval.eval_h("lagged-introduction-rule");
	Handle results = bindlink(&as, rule);
	Handle expected = eval.eval_h
		("(SetLink"
		 "(LaggedLink (stv 1 1)"
		 "	(PredicateNode \"P\" (stv 1 1))"
		 "	(SLink"
		 "		(ZLink)))"
		 "(LaggedLink (stv 1 1)"
		 "	(PredicateNode \"P\" (stv 1 1))"
		 "	(ZLink))"
		 "(LaggedLink (stv 1 1)"
		 "	(PredicateNode \"Q\" (stv 1 1))"
		 "	(ZLink))"
		 "(LaggedLink (stv 1 1)"		
		 "	(PredicateNode \"Q\" (stv 1 1))"
		 "	(SLink"
		 "		(ZLink))))");

	std::cout << "results = " << results->to_string();
	std::cout << "expected = " << expected->to_string();

	TS_ASSERT_EQUALS(results, expected);
}

/**
 * Test cogscm temporal-deduction-rule defined in:
 * opencog/pln/rules/temporal/back-predictive-implication-scope-deduction-cogscm.scm
 */
void TemporalReasoningUTest::test_cogscm_temporal_deduction()
{
	logger().debug("BEGIN TEST: %s", __FUNCTION__);

	load_scm_files({"tests/pln/rules/temporal-deduction.scm",
	                "opencog/pln/rules/temporal/back-predictive-implication-scope-deduction-cogscm.scm"});

	// Apply the rules
	Handle rule = eval.eval_h("back-predictive-implication-scope-deduction-cogscm-rule");

	Handle results = bindlink(&as, rule);
	Handle expected = eval.eval_h
		("(SetLink"
		 "(BackPredictiveImplicationScopeLink"
		 "	(VariableNode \"$X\")"
		 "	(SLink (SLink"
		 "		(ZLink)))"
		 "(BackSequentialAndLink"
		 "	(SLink"
		 "		(ZLink))"
		 "	(EvaluationLink"
		 "		(PredicateNode \"P\")"
		 "		(VariableNode \"$X\"))"
		 "	(ExecutionLink"
         "		(SchemaNode \"A2\")))"
    	 "(EvaluationLink"
      	 "	(PredicateNode \"R\")"
      	 "	(VariableNode \"$X\")))"
		 "(BackPredictiveImplicationScopeLink"
		 "	(VariableNode \"$X\")"
		 "	(SLink (SLink"
		 "		(ZLink)))"
		 "	(BackSequentialAndLink"
		 "		(SLink"
		 "			(ZLink))"
		 "  	(AndLink"
		 "			(ExecutionLink"
		 "				(SchemaNode \"A1\"))"
		 "			(EvaluationLink"
		 "				(PredicateNode \"C\")"
		 "				(VariableNode \"$X\")))"
		 "		(ExecutionLink"
         "			(SchemaNode \"A2\")))"
    	 "	(EvaluationLink"
      	 "		(PredicateNode \"R\")"
      	 "		(VariableNode \"$X\"))))");
		   
	std::cout << "results = " << results->to_string();
	std::cout << "expected = " << expected->to_string();

	TS_ASSERT_EQUALS(results, expected);
}
